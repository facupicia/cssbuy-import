# Opcional: Credenciales de Supabase para sincronizar cotizaciones en la nube
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=

# CSSBuy: credenciales para el sync automático de órdenes (https://www.cssbuy.com/shop/cate/order)
CSSBUY_USER=
CSSBUY_PASS=

# PostgreSQL propio donde se guardan las órdenes (tabla cssbuy_orders)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# Publicidad: todas estas variables son privadas, solo del servidor.
# Clave independiente de al menos 32 caracteres para el conector de lectura.
BUSINESS_READ_API_KEY=
# Origen público del panel para validar ingreso detrás de un reverse proxy.
BUSINESS_APP_ORIGIN=https://db.vidaeventofiesta.site
# ADMIN_PASSWORD (arriba) necesita al menos 12 caracteres para abrir /publicidad.
# Token de Meta con ads_read y acceso a la cuenta. Nunca usar NEXT_PUBLIC_.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Versión vigente habilitada en tu app de Meta, por ejemplo vXX.0.
META_GRAPH_API_VERSION=
