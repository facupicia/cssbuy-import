# Opcional: Credenciales de Supabase para sincronizar cotizaciones en la nube
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Clave interna estable: alta inicial y cifrado de Tiendanube. No es tu nueva contraseña personal.
ADMIN_PASSWORD=
# Opcional, mínimo 32 caracteres. Si falta se deriva una clave de sesiones del secreto interno.
BETTER_AUTH_SECRET=

# CSSBuy: credenciales para el sync automático de órdenes (https://www.cssbuy.com/shop/cate/order)
CSSBUY_USER=
CSSBUY_PASS=

# PostgreSQL propio donde se guardan las órdenes (tabla cssbuy_orders)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# Publicidad: todas estas variables son privadas, solo del servidor.
# Clave independiente de al menos 32 caracteres para el conector de lectura.
BUSINESS_READ_API_KEY=
# Origen público del panel para validar ingreso detrás de un reverse proxy.
BUSINESS_APP_ORIGIN=https://db.vidaeventofiesta.site
# El panel usa la cuenta personal. ADMIN_PASSWORD necesita al menos 12 caracteres para el alta inicial.
# Token de Meta con ads_read y acceso a la cuenta. Nunca usar NEXT_PUBLIC_.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Versión vigente habilitada en tu app de Meta, por ejemplo vXX.0.
META_GRAPH_API_VERSION=

# Tiendanube: aplicación autorizada con permisos de lectura/escritura de productos.
# Todas las credenciales quedan en el servidor. Nunca usar NEXT_PUBLIC_.
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
# Nombre de tu aplicación y correo de contacto, p. ej. PLUG (contacto@tudominio.com)
TIENDANUBE_USER_AGENT=
# Si usás varios depósitos, seleccioná el depósito que representa este inventario.
TIENDANUBE_LOCATION_ID=
# La publicación requiere sesión personal; ADMIN_PASSWORD conserva el cifrado de la conexión.
